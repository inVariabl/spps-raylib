#!/bin/sh

APP_NAME="rayscape"
SOURCE_FILES="src/main.c src/player.c src/world.c src/ui.c src/combat.c src/npc.c src/ship_minigame.c spps-voyage/src/objects.c spps-voyage/src/ocean.c spps-voyage/src/spawner.c spps-voyage/src/collision.c spps-voyage/src/crew.c spps-voyage/src/interior.c"
VOYAGE_NAME="voyage"
VOYAGE_SOURCE_FILES="spps-voyage/src/main.c spps-voyage/src/objects.c spps-voyage/src/ocean.c spps-voyage/src/spawner.c spps-voyage/src/collision.c spps-voyage/src/crew.c spps-voyage/src/interior.c"
COMPILER="gcc"
CFLAGS="-I./src -I./spps-voyage/src -Wall -std=c99 -Wno-missing-braces"
VOYAGE_CFLAGS="-I./spps-voyage/src -Wall -std=c99 -Wno-missing-braces"
LDFLAGS="-lraylib -lGL -lm -lpthread -ldl -lrt -lX11"

echo "⚔️  Forging the binary: $APP_NAME..."

$COMPILER $SOURCE_FILES -o $APP_NAME $CFLAGS $LDFLAGS || {
    echo "❌ Smithing failed. Check the errors above."
    exit 1
}

echo "⛵ Forging the voyage level: $VOYAGE_NAME..."

$COMPILER $VOYAGE_SOURCE_FILES -o $VOYAGE_NAME $VOYAGE_CFLAGS $LDFLAGS || {
    echo "❌ Voyage build failed. Check the errors above."
    exit 1
}

echo "✅ Success! Run './$APP_NAME' to start the main game."
