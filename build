#!/bin/sh

APP_NAME="rayscape"
SOURCE_FILES="src/main.c src/player.c src/world.c src/ui.c src/combat.c src/npc.c"
COMPILER="clang" # clang is the default on Mac, though 'gcc' usually aliases to it

# Added the Homebrew include path so it can find raylib.h
CFLAGS="-I./src -I/opt/homebrew/include -Wall -std=c99 -Wno-missing-braces"

# Swapped Linux flags for macOS Frameworks and Homebrew library paths
LDFLAGS="-L/opt/homebrew/lib -lraylib -framework CoreVideo -framework IOKit -framework Cocoa -framework GLUT -framework OpenGL"

echo "⚔️  Forging the binary: $APP_NAME..."

$COMPILER $SOURCE_FILES -o $APP_NAME $CFLAGS $LDFLAGS

if [ $? -eq 0 ]; then
    echo "✅ Success! Run './$APP_NAME' to start your adventure."
    ./$APP_NAME
else
    echo "❌ Smithing failed. Check the errors above."
fi
